<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom|end"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_background"
        android:backgroundTint="#00000000"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="2dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/widget_info"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="bottom|end"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/widget_status_row"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="bottom|end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/google_sans_flex_medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.3"
                    android:maxLines="1"
                    android:text="@string/widget_status_stopped"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/widget_badge"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_badge_stopped" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_flex_bold"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_flex_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical|end"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_previous"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_previous"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_skip_back" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_next"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_skip_forward" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_play"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_play_circle" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
